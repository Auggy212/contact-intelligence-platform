# =============================================================================
# Contract Intelligence Platform — Environment Configuration
# =============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the required values marked with TODO
#   3. Switch between "Docker mode" and "local mode" using the notes below
#
# RUNNING WITH DOCKER COMPOSE (recommended — default):
#   All service hostnames use Docker Compose service names (db, redis, etc.)
#   Run: make setup && make dev
#
# RUNNING UVICORN ON HOST MACHINE (without Docker for the app):
#   Change the hostnames below from service names to localhost:
#     db     → localhost
#     redis  → localhost
#     minio  → localhost
#     qdrant → localhost
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Contract Intelligence Platform
APP_VERSION=0.1.0

# TODO: Generate a real secret — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000


# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose mode (default): host = "db" (the compose service name)
DATABASE_URL=postgresql+asyncpg://cipuser:cippassword@db:5432/cipdb

# Company-provided Postgres (when the company gives you a managed DB):
# Replace the entire URL with the connection string they provide, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@your-rds-host.amazonaws.com:5432/cipdb

# Local mode (uvicorn on host, not in Docker):
# DATABASE_URL=postgresql+asyncpg://cipuser:cippassword@localhost:5432/cipdb


# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose mode (default):
REDIS_URL=redis://redis:6379/0

# Company-provided Redis (ElastiCache, etc.):
# REDIS_URL=redis://:password@your-elasticache-host.amazonaws.com:6379/0

# Local mode:
# REDIS_URL=redis://localhost:6379/0


# ── File Storage ──────────────────────────────────────────────────────────────
# Set to "minio" for local/Docker dev, "s3" when company provides AWS S3
STORAGE_BACKEND=minio

# MinIO (Docker Compose — service name is "minio"):
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contract-intelligence
MINIO_SECURE=false

# MinIO local mode (uvicorn on host):
# MINIO_ENDPOINT=localhost:9000

# AWS S3 (when company provides S3 — set STORAGE_BACKEND=s3 above):
# TODO: Fill these in when company provides AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=contract-intelligence-prod

# S3-compatible alternative (Cloudflare R2, DigitalOcean Spaces, etc.):
# These reuse the MINIO_* variables — just set MINIO_ENDPOINT to the provider
# endpoint and MINIO_SECURE=true, then keep STORAGE_BACKEND=minio


# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# TODO: Get these from https://dashboard.clerk.com → API Keys
# The webhook secret comes from Clerk Dashboard → Webhooks → your endpoint
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# NOTE: With placeholder values, the server starts but all authenticated
# endpoints return 401. This is expected in dev without real Clerk keys.
# The Clerk webhook handler auto-bypasses signature check when secret = "whsec_placeholder".


# ── AI Services ───────────────────────────────────────────────────────────────
# TODO: Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_OPUS_MODEL=claude-opus-4-7

# TODO: Get from https://dash.voyageai.com → API Keys
VOYAGE_API_KEY=pa-placeholder
VOYAGE_MODEL=voyage-law-2

# NOTE: With placeholder AI keys, the server starts and the DB/parsing pipeline
# works, but AI agent tasks will fail when actually called.


# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
# Docker Compose mode (default):
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Qdrant Cloud (when company provides a hosted Qdrant cluster):
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-api-key

# Local mode:
# QDRANT_URL=http://localhost:6333

QDRANT_LAW_COLLECTION=indian_law_corpus


# ── Pluggable AI providers (Phase 6 — semantic / RAG) ─────────────────────────
# Each capability switches INDEPENDENTLY; no code change needed.
#   EMBEDDING_PROVIDER: nvidia | local | voyage | openai   (default: nvidia)
#   LLM_PROVIDER:       nvidia | groq | gemini | anthropic | bedrock
#   VECTOR_STORE:       qdrant | pgvector
EMBEDDING_PROVIDER=nvidia
LLM_PROVIDER=groq
VECTOR_STORE=qdrant

# Master switch for the Phase 6 semantic pipeline (embed-on-upload + /search).
# Set true to run real embeddings even in APP_ENV=testing, so you can upload a
# document and immediately search it. Leave false to skip all embedding-API
# calls (and the automated pytest suite always forces it false → zero credits).
ENABLE_EMBEDDINGS=false

# NVIDIA NIM (build.nvidia.com) — free tier, OpenAI-compatible. Key starts nvapi-.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIM=1024
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct

# Local embedding fallback (only used if EMBEDDING_PROVIDER=local; needs sentence-transformers)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIM=384

# Other free LLM options (set the key for whichever LLM_PROVIDER you choose)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=


# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# TODO: Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_STARTER=price_placeholder
STRIPE_PRICE_PROFESSIONAL=price_placeholder


# ── Email ─────────────────────────────────────────────────────────────────────
# "console" prints emails to stdout (dev mode — no real emails sent)
# "resend" sends real emails via Resend API
EMAIL_BACKEND=console

# TODO: Get from https://resend.com → API Keys (only needed when EMAIL_BACKEND=resend)
RESEND_API_KEY=re_placeholder
EMAIL_FROM=noreply@contractintelligence.in


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
