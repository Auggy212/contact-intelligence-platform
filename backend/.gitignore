# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
*.so

# ── Environment — NEVER commit .env (contains secrets) ───────────────────────
.env
# .env.example IS committed — it is the template with placeholder values only

# ── Tests & coverage ─────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker volume data (local only, not part of source) ───────────────────────
postgres_data/
redis_data/
minio_data/
qdrant_data/

# ── Alembic compiled files ────────────────────────────────────────────────────
alembic/versions/*.pyc

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Law corpus downloads (PDFs are large; .txt files are also excluded since
#    they are regenerated by `make seed-law` from the official source) ────────
data/laws/*.pdf
data/laws/*.txt
