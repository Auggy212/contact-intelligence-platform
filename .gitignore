# =============================================================================
# Contract Intelligence Platform — .gitignore
# =============================================================================

# ── Environment files (NEVER commit these) ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
backend/.env
frontend/.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker volumes / local data ───────────────────────────────────────────────
postgres_data/
redis_data/
minio_data/
qdrant_data/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
*.key
celerybeat-schedule
celerybeat.pid
